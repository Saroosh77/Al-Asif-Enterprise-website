# Public website and domain
DOMAIN=example.com
SITE_URL=https://example.com
ALLOWED_ORIGINS=https://example.com
LETSENCRYPT_EMAIL=admin@example.com

# Destination for website inquiries
CONTACT_TO_EMAIL=asifmumtazk@gmail.com

# SMTP account used to send inquiries. Never commit the real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=asifmumtazk@gmail.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM_NAME=Al-Asif Enterprise Website
SMTP_FROM_EMAIL=asifmumtazk@gmail.com

# Basic anti-spam rate limit per visitor IP
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000
