{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "al-asif-enterprise",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/privacy",
      "/_vinext/*",
      "/api/*"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "alasifenterprise.com.pk",
      "custom_domain": true
    },
    {
      "pattern": "www.alasifenterprise.com.pk",
      "custom_domain": true
    }
  ]
}
